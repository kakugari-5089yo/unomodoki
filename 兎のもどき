/* ================================
   ルーレット
================================ */

function startRoulette(){

    if(rouletteRunning){

        return;

    }

    rouletteRunning = true;

    const count =
        onlineMode
            ? Math.max(2,onlinePlayerCount)
            : cpuCount + 1;

    let elapsed = 0;

    const interval =
        setInterval(
            ()=>{

                const index =
                    Math.floor(
                        Math.random()*count
                    );

                rouletteName.textContent =
                    players[index].name;

                elapsed += 100;

                if(elapsed>=1800){

                    clearInterval(interval);

                    currentPlayer =
                        Math.floor(
                            Math.random()*count
                        );

                    rouletteName.textContent =
                        players[currentPlayer].name;

                    setTimeout(
                        ()=>{
                            rouletteOverlay.classList.add(
                                "hidden"
                            );

                            gameStarted = true;

                            render();

                            if(
                                onlineMode &&
                                onlineIsHost
                            ){

                                onlineBroadcastState();

                            }

                            /*
                               CPU開始
                            */

                            if(
                                players[currentPlayer].type==="cpu"
                            ){

                                setTimeout(
                                    cpuTurn,
                                    700
                                );

                            }

                        },
                        500
                    );

                }

            },
            100
        );

}

