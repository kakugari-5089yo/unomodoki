<script>
"use strict";

/* ================================
   基本データ
================================ */

const COLORS = [
    "red",
    "yellow",
    "green",
    "blue"
];

const COLOR_NAMES = {
    red:"赤",
    yellow:"黄",
    green:"緑",
    blue:"青"
};

const EXODIA_TYPES = [
    "head",
    "leftArm",
    "rightArm",
    "leftLeg",
    "rightLeg"
];

const players = [
    {
        id:0,
        name:"あなた",
        type:"human",
        hand:[],
        finished:false
    },
    {
        id:1,
        name:"CPU 1",
        type:"cpu",
        hand:[],
        finished:false
    },
    {
        id:2,
        name:"CPU 2",
        type:"cpu",
        hand:[],
        finished:false
    },
    {
        id:3,
        name:"CPU 3",
        type:"cpu",
        hand:[],
        finished:false
    }
];

let cpuCount = 3;

let deck = [];
let discardPile = [];

let currentPlayer = 0;
let direction = 1;

let currentColor = null;

let pendingDraw = 0;
let pendingDrawSource = null;

let gameStarted = false;
let gameOver = false;

let awaitingColor = false;
let rouletteRunning = false;

let playerSaidUno = false;
let unoPenaltyApplied = false;
let unoProcessing = false;

let exodiaReturnCard = null;

/* ================================
   オンライン対戦データ
================================ */

let onlineMode = false;
let onlineIsHost = false;
let onlineReady = false;

let onlinePeer = null;
let onlineRoomCode = "";

let onlineName = "プレイヤー";

let onlinePlayerSlot = 0;
let onlinePlayerCount = 1;

let onlineConnections = {};

let onlineStarting = false;

/* ================================
   DOM
================================ */

