            }
        );

}

/* ================================
   ゲーム状態を保存
================================ */

function onlineSerializeState(){

    return {

        deck,

        discardPile,

        currentPlayer,

        direction,

        currentColor,

        pendingDraw,

        pendingDrawSourceId:
            pendingDrawSource
                ? pendingDrawSource.id
                : null,

        gameStarted,

        gameOver,

        awaitingColor,

        rouletteRunning,

        playerSaidUno,

        unoPenaltyApplied,

        unoProcessing,

        exodiaReturnCard,

        onlinePlayerCount,

        players:
            players.map(
                player=>({

                    id:player.id,

                    name:player.name,

                    type:player.type,

                    hand:player.hand,

                    finished:player.finished

                })
            )

    };

}

/* ================================
   ゲーム状態を適用
================================ */

function onlineApplyState(state){

    if(!state){
        return;
    }

    deck =
        state.deck || [];

    discardPile =
        state.discardPile || [];

    currentPlayer =
        Number.isInteger(
            state.currentPlayer
        )
            ? state.currentPlayer
            : 0;

    direction =
        state.direction || 1;

    currentColor =
        state.currentColor || null;

    pendingDraw =
        state.pendingDraw || 0;

    pendingDrawSource =
        state.pendingDrawSourceId == null
            ? null
            : players[
                state.pendingDrawSourceId
            ];

    gameStarted =
        !!state.gameStarted;

    gameOver =
        !!state.gameOver;

    awaitingColor =
        !!state.awaitingColor;

    rouletteRunning =
        !!state.rouletteRunning;

    playerSaidUno =
        !!state.playerSaidUno;

    unoPenaltyApplied =
        !!state.unoPenaltyApplied;

    unoProcessing =
        !!state.unoProcessing;

    exodiaReturnCard =
        state.exodiaReturnCard ||
        null;

    onlinePlayerCount =
        state.onlinePlayerCount ||
        onlinePlayerCount;

    (
        state.players || []
    ).forEach(
        (player,index)=>{

            if(!players[index]){
                return;
            }

            players[index].id =
                player.id;

            players[index].name =
                player.name;

            players[index].type =
                player.type;

            players[index].hand =
                player.hand || [];

            players[index].finished =
                !!player.finished;

        }
    );

    document
        .getElementById("onlineBadge")
        .classList.remove("hidden");

    /*
       クライアント側の画面制御
    */

    if(
        onlineMode &&
        !onlineIsHost
    ){

        if(state.gameStarted){

            rouletteOverlay.classList.add(
                "hidden"
            );

            onlineOverlay.classList.add(
                "hidden"
            );

            game.classList.remove(
                "hidden"
            );

        }else if(
            state.rouletteRunning
        ){

            rouletteOverlay.classList.remove(
                "hidden"
            );

            rouletteName.textContent =
                "ホストが決定中…";

        }

    }

    render();

    if(
        gameStarted &&
        currentPlayer===onlinePlayerSlot &&
        !gameOver
    ){

        showMessage(
            "あなたのターンです。"
        );

    }

}

/* ================================
   ホスト状態送信
================================ */

function onlineBroadcastState(){

    if(
        !onlineMode ||
        !onlineIsHost
    ){

        return;

    }

    onlineBroadcast({

        type:"state",

        state:
            onlineSerializeState()

    });

}

/* ================================
   オンラインメッセージ処理
================================ */

function onlineHandleMessage(
    slot,
    data
){

    if(!data){
        return;
    }

    /*
       ホスト
    */

    if(onlineIsHost){

        if(
            data.type==="action"
        ){

            if(
                !gameStarted ||
                gameOver ||
                currentPlayer!==slot
            ){

                return;

            }

            if(
                data.action==="play"
            ){

                playerPlay(
                    Number(data.index),
                    slot
                );

            }else if(
                data.action==="draw"
            ){

                playerDraw(
                    slot
                );

            }else if(
                data.action==="uno"
            ){

                playerUno(
                    slot
                );

            }else if(
                data.action==="color"
            ){

                selectColor(
                    data.color,
                    slot
                );

            }

            onlineBroadcastState();

        }

        return;

    }

    /*
       クライアント
    */

    if(
        data.type==="state"
    ){

        onlineApplyState(
            data.state
        );

    }

    if(
        data.type==="room-full"
    ){

        onlineSetStatus(
            "この部屋は満員です。"
        );

    }

    if(
        data.type==="host-started"
    ){

        onlineSetStatus(
            "ゲームを開始しています…"
        );

    }

}

/* ================================
   部屋作成
================================ */

function onlineCreateRoom(){

    if(
        typeof Peer === "undefined"
    ){

        onlineSetStatus(
            "オンライン機能の読み込みに失敗しました。インターネット接続を確認してください。"
        );

        return;

    }

    onlineName =
        (
            document
                .getElementById(
                    "onlineNameInput"
                )
                .value
                .trim()
            ||
            "プレイヤー"
        ).slice(0,12);

    /*
       まずルームコードを即時生成
    */

    let generatedCode = "";

    for(
        let attempt=0;
        attempt<8;
        attempt++
    ){

        generatedCode =
            Math.random()
                .toString(36)
                .slice(2,8)
                .toUpperCase();

        if(
            generatedCode.length===6
        ){

            break;

        }

    }

    onlineRoomCode =
        generatedCode;

    onlineMode = true;

    onlineIsHost = true;

    onlineReady = false;

    onlinePlayerSlot = 0;

    onlinePlayerCount = 1;

    players[0].name =
        onlineName;

    players[0].type =
        "human";

    /*
       先にルーム画面を表示
    */

    onlineShowRoom();

    onlineRoomCodeElement.textContent =
        onlineRoomCode;

    onlineSetStatus(
        "ルームコードを発行しました。接続しています…"
    );

    /*
       PeerJS用ID
    */

    const peerId =
        "uno-exodia-" +
        generatedCode.toLowerCase();

    try{

        onlinePeer =
            new Peer(
                peerId,
                {
                    debug:0
                }
            );

    }catch(error){

        onlineSetStatus(
            "通信の準備に失敗しました。"
        );

        console.error(error);

        return;

    }

    /*
       PeerJS接続完了
    */

    onlinePeer.on(
        "open",
        id=>{

            onlineReady = true;

            onlinePeer.__fullId =
                id;

            onlineSetStatus(
                "部屋を作成しました。ルームコードを友達に伝えてください。"
            );

            onlineShowRoom();

        }
    );

    /*
       他プレイヤー接続
    */

    onlinePeer.on(
        "connection",
        connection=>{

            if(
                onlinePlayerCount>=4
            ){

                onlineSend(
                    connection,
                    {
                        type:"room-full"
                    }
                );

                setTimeout(
                    ()=>{
                        try{
                            connection.close();
                        }catch(e){}
                    },
                    300
                );

                return;

            }

            const slot =
                onlinePlayerCount;

            onlinePlayerCount++;

            onlineConnections[slot] =
                connection;

            connection.on(
                "open",
                ()=>{

                    onlineSend(
                        connection,
                        {
                            type:"assign",
                            slot,
                            room:onlineRoomCode,
                            hostId:
                                onlinePeer.__fullId
                        }
                    );

                }
            );

            connection.on(
                "data",
                data=>{

                    if(
                        data &&
                        data.type==="hello"
                    ){

                        players[slot].name =
                            String(
                                data.name ||
                                `プレイヤー${slot+1}`
                            ).slice(0,12);

                        players[slot].type =
                            "human";

                        players[slot].finished =
                            false;

                        onlineSetPlayerList();

                        onlineSend(
                            connection,
                            {
                                type:"state",
                                state:
                                    onlineSerializeState(),
                                slot
                            }
                        );

                        onlineSetStatus(
                            `${players[slot].name} が参加しました。`
                        );

                        onlineBroadcastState();

                    }else{

                        onlineHandleMessage(
                            slot,
                            data
                        );

                    }

                }
            );

            connection.on(
                "close",
                ()=>{

                    players[slot].finished =
                        true;

                    onlineSetStatus(
                        `${players[slot].name} が退出しました。`
                    );

                    onlineSetPlayerList();

                    onlineBroadcastState();

                }
            );

            connection.on(
                "error",
                error=>{

                    console.error(
                        "Peer接続エラー",
                        error
                    );

                }
            );

        }
    );

    /*
       PeerJSエラー
    */

    onlinePeer.on(
        "error",
        error=>{

            console.error(
                "PeerJS error:",
                error
            );

            if(
                error &&
                error.type==="unavailable-id"
            ){

                onlineSetStatus(
                    "このルームコードは使用中です。もう一度「部屋を作る」を押してください。"
                );

            }else{

                onlineSetStatus(
                    "オンライン接続でエラーが発生しました。"
                );

            }

        }
    );

}

/* ================================
   部屋参加
================================ */

function onlineJoinRoom(){

    if(
        typeof Peer === "undefined"
    ){

        onlineSetStatus(
            "オンライン機能の読み込みに失敗しました。"
        );

        return;

    }

    onlineName =
        (
            document
                .getElementById(
                    "onlineNameInput"
                )
                .value
                .trim()
            ||
            "プレイヤー"
        ).slice(0,12);

    const code =
        document
            .getElementById(
                "onlineRoomInput"
            )
            .value
            .trim()
            .toUpperCase();

    if(!code){

        onlineSetStatus(
            "ルームコードを入力してください。"
        );

        return;

    }

    if(code.length!==6){

        onlineSetStatus(
            "6文字のルームコードを入力してください。"
        );

        return;

    }

    onlineCloseConnections();

    onlineMode = true;

    onlineIsHost = false;

    onlineReady = false;

    onlineSetStatus(
        "部屋を探しています…"
    );

    /*
       クライアント側Peer
    */

    try{

        onlinePeer =
            new Peer(
                undefined,
                {
                    debug:0
                }
            );

    }catch(error){

        onlineSetStatus(
            "通信の準備に失敗しました。"
        );

        return;

    }

    onlinePeer.on(
        "open",
        ()=>{

            const target =
                "uno-exodia-" +
                code.toLowerCase();

            const connection =
                onlinePeer.connect(
                    target,
                    {
                        reliable:true
                    }
                );

            onlineConnections.host =
                connection;

            connection.on(
                "open",
                ()=>{

                    onlineSend(
                        connection,
                        {
                            type:"hello",
                            name:onlineName
                        }
                    );

                    onlineSetStatus(
                        "ホストに接続しました。"
                    );

                }
            );

            connection.on(
                "data",
                data=>{

                    if(!data){
                        return;
                    }

                    if(
                        data.type==="assign"
                    ){

                        onlinePlayerSlot =
                            Number(
                                data.slot
                            );

                        onlinePlayerCount =
                            Math.max(
                                onlinePlayerCount,
                                onlinePlayerSlot+1
                            );

                        onlineRoomCode =
                            data.room ||
                            code;

                        players[
                            onlinePlayerSlot
                        ].name =
                            onlineName;

                        players[
                            onlinePlayerSlot
                        ].type =
                            "human";

                        onlineShowRoom();

                        onlineSetStatus(
                            "参加しました。ホストがゲームを開始するまで待ってください。"
                        );

                    }else{

                        onlineHandleMessage(
                            0,
                            data
                        );

                    }

                }
            );

            connection.on(
                "close",
                ()=>{

                    onlineSetStatus(
                        "ホストとの接続が切れました。"
                    );

                }
            );

            connection.on(
                "error",
                error=>{

                    console.error(
                        "接続エラー",
                        error
                    );

                    onlineSetStatus(
                        "ルームに接続できませんでした。コードを確認してください。"
                    );

                }
            );

        }
    );

    onlinePeer.on(
        "error",
        error=>{

            console.error(
                "PeerJS error:",
                error
            );

            onlineSetStatus(
                "ルームに接続できませんでした。コードを確認してください。"
            );

        }
    );

}

/* ================================
   オンラインゲーム開始
================================ */

function onlineStartGame(){

    if(!onlineIsHost){

        return;

    }

    if(
        onlinePlayerCount<2
    ){

        onlineSetStatus(
            "2人以上参加してからゲームを開始してください。"
        );

        return;

    }

    if(onlineStarting){

        return;

    }

    onlineStarting = true;

    cpuCount =
        onlinePlayerCount - 1;

    onlineStartButton.disabled =
        true;

    onlineSetStatus(
        "ゲームを準備しています…"
    );

    onlineOverlay.classList.add(
        "hidden"
    );

    game.classList.remove(
        "hidden"
    );

    document
        .getElementById(
            "backToMenuButton"
        )
        .classList.remove(
            "hidden"
        );

    rouletteOverlay.classList.remove(
        "hidden"
    );

    rouletteName.textContent =
        "?";

    initializeGame();

    onlineBroadcastState();

}

