    document.getElementById("game");

const rouletteOverlay =
    document.getElementById("rouletteOverlay");

const colorOverlay =
    document.getElementById("colorOverlay");

const winOverlay =
    document.getElementById("winOverlay");

const winBox =
    document.getElementById("winBox");

const rouletteName =
    document.getElementById("rouletteName");

const playerHand =
    document.getElementById("playerHand");

const deckElement =
    document.getElementById("deck");

const discardElement =
    document.getElementById("discard");

const messageElement =
    document.getElementById("message");

const effectLayer =
    document.getElementById("effectLayer");

const turnIndicator =
    document.getElementById("turnIndicator");

const cpuTop =
    document.getElementById("cpuTop");

const cpuLeft =
    document.getElementById("cpuLeft");

const cpuRight =
    document.getElementById("cpuRight");

