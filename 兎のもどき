    document.getElementById("onlineOverlay");

const onlineHomePanel =
    document.getElementById("onlineHomePanel");

const onlineRoomPanel =
    document.getElementById("onlineRoomPanel");

const onlineStartButton =
    document.getElementById("onlineStartButton");

const onlineRoomCodeElement =
    document.getElementById("onlineRoomCode");

const onlineRoleText =
    document.getElementById("onlineRoleText");

const onlinePlayerList =
    document.getElementById("onlinePlayerList");

const onlineStatus =
    document.getElementById("onlineStatus");

const onlineRoomStatus =
    document.getElementById("onlineRoomStatus");

/* ================================
   メニュー
================================ */

function showMainMenu(){

    titleScreen.classList.add("hidden");

    settingsScreen.classList.add("hidden");

    game.classList.add("hidden");

    rouletteOverlay.classList.add("hidden");

    winOverlay.classList.add("hidden");

    mainMenu.classList.remove("hidden");
}

function showSettings(){

    mainMenu.classList.add("hidden");

    settingsScreen.classList.remove("hidden");

}

function applyCpuCount(){

    const value =
        Number(
            document.getElementById(
                "cpuCountSelect"
            ).value
        );

    if(
        Number.isInteger(value) &&
        value >= 1 &&
        value <= 3
    ){
        cpuCount = value;
    }
}

function startGameFromMainMenu(){

    applyCpuCount();

    mainMenu.classList.add("hidden");

    startNewGame();

}

function startNewGame(){

    onlineStarting = false;

    game.classList.remove("hidden");

    document
        .getElementById("backToMenuButton")
        .classList.remove("hidden");

    winOverlay.classList.add("hidden");

    rouletteOverlay.classList.remove("hidden");

    rouletteName.textContent = "?";

    initializeGame();

}

function backToMainMenu(){

    onlineCloseConnections();

    onlineMode = false;
    onlineIsHost = false;

    game.classList.add("hidden");

    rouletteOverlay.classList.add("hidden");

    colorOverlay.classList.add("hidden");

    winOverlay.classList.add("hidden");

    turnIndicator.classList.add("hidden");

    document
        .getElementById("backToMenuButton")
        .classList.add("hidden");

    mainMenu.classList.remove("hidden");

}

function openOnlineMenu(){

    mainMenu.classList.add("hidden");

    onlineOverlay.classList.remove("hidden");

    onlineHomePanel.classList.remove("hidden");

    onlineRoomPanel.classList.add("hidden");

    onlineSetStatus("");

}

function leaveOnline(){

    onlineCloseConnections();

    onlineMode = false;
    onlineIsHost = false;

    onlineOverlay.classList.add("hidden");

    onlineHomePanel.classList.remove("hidden");

    onlineRoomPanel.classList.add("hidden");

    mainMenu.classList.remove("hidden");

}

/* ================================
   メッセージ
================================ */

let messageTimer = null;

function showMessage(text, duration=1800){

    messageElement.textContent = text;

    messageElement.classList.remove("hidden");

    clearTimeout(messageTimer);

    messageTimer =
        setTimeout(()=>{
            messageElement.classList.add("hidden");
        },duration);

}

/* ================================
   エフェクト
================================ */

function showEffect(text){

    const element =
        document.createElement("div");

    element.className = "effect-text";

    element.textContent = text;

    effectLayer.appendChild(element);

    setTimeout(()=>{
        element.remove();
    },1200);

}

function shakeScreen(){

    game.classList.remove("shake");

    void game.offsetWidth;

    game.classList.add("shake");
}
/* ================================
   カード生成
================================ */

function createCard(color, value, extra={}){

    return {
        id:
            Math.random()
                .toString(36)
                .slice(2),

        color,
        value,

        type:
            extra.type || "normal",

        exodia:
            extra.exodia || null
    };

}

/* ================================
   デッキ生成
================================ */

function createDeck(){

    const cards = [];

    for(const color of COLORS){

        cards.push(
            createCard(color,"0")
        );

        for(let n=1;n<=2;n++){

            cards.push(
                createCard(color,String(n))
            );

            cards.push(
                createCard(color,String(n))
            );

        }

        for(let i=0;i<2;i++){

            cards.push(
                createCard(
                    color,
                    "SKIP",
                    {type:"skip"}
                )
            );

            cards.push(
                createCard(
                    color,
                    "REVERSE",
                    {type:"reverse"}
                )
            );

            cards.push(
                createCard(
                    color,
                    "+2",
                    {type:"draw2"}
                )
            );

        }

    }

    for(let i=0;i<4;i++){

        cards.push(
            createCard(
                "black",
                "WILD",
                {type:"wild"}
            )
        );

        cards.push(
            createCard(
                "black",
                "WILD +4",
                {type:"wild4"}
            )
        );

    }

    /*
       Exodiaカード
    */

    for(const type of EXODIA_TYPES){

        cards.push(
            createCard(
                "black",
                "EXODIA",
                {
                    type:"exodia",
                    exodia:type
                }
            )
        );

    }

    /*
       Exodiaカードを追加
       特殊ルール用の予備カード
    */

    for(let i=0;i<5;i++){

        cards.push(
            createCard(
                "black",
                "EXODIA",
                {
                    type:"exodia",
                    exodia:EXODIA_TYPES[i]
                }
            )
        );

    }

    return cards;

}

/* ================================
   シャッフル
================================ */

function shuffle(array){

    for(
        let i=array.length-1;
        i>0;
        i--
    ){

        const j =
            Math.floor(
                Math.random()*(i+1)
            );

        [
            array[i],
            array[j]
        ] =
        [
            array[j],
            array[i]
        ];

    }

    return array;

}

/* ================================
   初期化
================================ */

function initializeGame(){

    deck =
        shuffle(
            createDeck()
        );

    discardPile = [];

    currentPlayer = 0;

    direction = 1;

    currentColor = null;

    pendingDraw = 0;

    pendingDrawSource = null;

    gameStarted = false;

    gameOver = false;

    awaitingColor = false;

    rouletteRunning = false;

    playerSaidUno = false;

    unoPenaltyApplied = false;

    unoProcessing = false;

    exodiaReturnCard = null;

    for(let i=0;i<players.length;i++){

        players[i].hand = [];

        players[i].finished = false;

        if(i===0){

            players[i].name =
                onlineMode && !onlineIsHost
                    ? onlineName
                    : "あなた";

            players[i].type = "human";

        }else{

            players[i].name =
                `CPU ${i}`;

            players[i].type =
                "cpu";

        }

    }

    if(onlineMode){

        /*
           オンライン時は
           接続人数に応じて人間プレイヤーを設定
        */

        for(
            let i=0;
            i<onlinePlayerCount;
            i++
        ){

            players[i].type = "human";

        }

        for(
            let i=onlinePlayerCount;
            i<4;
            i++
        ){

            players[i].type = "cpu";

        }

    }

    /*
       カード配布
    */

    const activePlayers =
        onlineMode
            ? Math.max(
                2,
                onlinePlayerCount
              )
            : cpuCount + 1;

    for(let i=0;i<activePlayers;i++){

        for(let n=0;n<7;n++){

            const card =
                drawFromDeck();

            if(card){

                players[i].hand.push(card);

            }

        }

    }

    /*
       非使用プレイヤーを非表示
    */

    for(
        let i=activePlayers;
        i<players.length;
        i++
    ){

        players[i].hand = [];

        players[i].finished = true;

    }

    /*
       最初の捨て札
    */

    let firstCard;

    do{

        firstCard =
            drawFromDeck();

    }while(
        firstCard &&
        (
            firstCard.type==="wild4" ||
            firstCard.type==="draw2" ||
            firstCard.type==="exodia"
        )
    );

    if(!firstCard){

        firstCard =
            drawFromDeck();

    }

    if(firstCard){

        discardPile.push(firstCard);

        currentColor =
            firstCard.color;

    }

    render();

    /*
       CPU人数・オンライン人数を反映
    */

    updatePlayerVisibility();

}

/* ================================
   山札から引く
================================ */

function drawFromDeck(){

    if(deck.length===0){

        refillDeck();

    }

    return deck.pop();

}

/* ================================
   捨て札から山札を補充
================================ */

function refillDeck(){

    if(discardPile.length<=1){

        return;

    }

    const top =
        discardPile.pop();

    deck =
        shuffle(
            discardPile.splice(0)
        );

    discardPile = [top];

}

/* ================================
   カード表示
================================ */

function createCardElement(
    card,
    small=false,
    clickable=false,
    index=-1
){

    const element =
        document.createElement("div");

    element.className =
        "card";

    if(card.color){

        element.classList.add(
            card.color
        );

    }

    if(card.type==="exodia"){

        element.classList.add(
            "exodia-card"
        );

    }

    if(card.type==="wild" ||
       card.type==="wild4"){

        element.classList.add(
            "black"
        );

    }

    if(clickable){

        element.classList.add(
            "player-card"
        );

        const playable =
            canPlayCard(card);

        if(playable){

            element.classList.add(
                "playable"
            );

        }else{

            element.classList.add(
                "unplayable"
            );

        }

        element.addEventListener(
            "click",
            ()=>{

                if(!playable){

                    showMessage(
                        "そのカードは出せません。"
                    );

                    return;

                }

                if(
                    onlineMode &&
                    !onlineIsHost
                ){

                    if(
                        onlineConnections.host
                    ){

                        onlineSend(
                            onlineConnections.host,
                            {
                                type:"action",
                                action:"play",
                                index
                            }
                        );

                    }

                    return;

                }

                playerPlay(
                    index,
                    onlineMode
                        ? onlinePlayerSlot
                        : 0
                );

            }

        );

    }

    const content =
        document.createElement("div");

    content.className =
        "card-content";

    if(card.type==="exodia"){

        const symbol =
            document.createElement("div");

        symbol.className =
            "exodia-symbol";

        symbol.textContent = "★";

        content.appendChild(symbol);

        const text =
            document.createElement("div");

        text.textContent =
            getExodiaName(
                card.exodia
            );

        content.appendChild(text);

    }else{

        content.textContent =
            displayCardValue(card);

    }

    element.appendChild(content);

    if(!small){

        const corner =
            document.createElement("div");

        corner.className =
            "card-corner";

        corner.textContent =
            displayCardValue(card);

        element.appendChild(corner);

        const bottom =
            document.createElement("div");

        bottom.className =
            "card-corner bottom";

        bottom.textContent =
            displayCardValue(card);

        element.appendChild(bottom);

    }

    return element;

}

/* ================================
   カード表示名
================================ */

function displayCardValue(card){

    if(card.type==="wild"){

        return "WILD";

    }

    if(card.type==="wild4"){

        return "WILD +4";

    }

    if(card.type==="draw2"){

        return "+2";

    }

    if(card.type==="reverse"){

        return "↔";

    }

    if(card.type==="skip"){

        return "×";

    }

    if(card.type==="exodia"){

        return "EXODIA";

    }

    return card.value;

}

function getExodiaName(type){

    switch(type){

        case "head":
            return "HEAD";

        case "leftArm":
            return "LEFT ARM";

        case "rightArm":
            return "RIGHT ARM";

        case "leftLeg":
            return "LEFT LEG";

        case "rightLeg":
            return "RIGHT LEG";

        default:
            return "EXODIA";

    }

}

/* ================================
   プレイ可能判定
================================ */

function canPlayCard(card){

    if(!gameStarted){

        return false;

    }

    if(gameOver){

        return false;

    }

    if(
        currentPlayer !==
        (
            onlineMode
                ? onlinePlayerSlot
                : 0
        )
    ){

        return false;

    }

    if(card.type==="wild"){

        return true;

    }

    if(card.type==="wild4"){

        return true;

    }

    if(
        pendingDraw>0
    ){

        /*
           ドロー中は
           通常カードを出せない
        */

        return false;

    }

    const top =
        discardPile[
            discardPile.length-1
        ];

    if(!top){

        return true;

    }

    if(card.type==="exodia"){

        return true;

    }

    if(top.type==="exodia"){

        return true;

    }

    if(
        card.color ===
        currentColor
    ){

        return true;

    }

    if(
        card.value ===
        top.value
    ){

        return true;

    }

    if(
        card.type ===
        top.type &&
        (
            card.type==="skip" ||
            card.type==="reverse" ||
            card.type==="draw2"
        )
    ){

        return true;

    }

    return false;

}

