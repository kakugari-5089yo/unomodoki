================================ */

function onlineCloseConnections(){

    Object
        .values(
            onlineConnections
        )
        .forEach(
            connection=>{

                try{

                    connection.close();

                }catch(e){}

            }
        );

    onlineConnections = {};

    if(onlinePeer){

        try{

            onlinePeer.destroy();

        }catch(e){}

    }

    onlinePeer = null;

    onlineReady = false;

}
