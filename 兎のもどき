<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>うのもどき</title>

<style>
*{
    box-sizing:border-box;
}

html,body{
    margin:0;
    width:100%;
    min-height:100%;
    font-family:"Segoe UI","Yu Gothic",sans-serif;
    background:
        radial-gradient(circle at center,#09803b,#075d2d 50%,#033b1c);
    color:white;
}

body{
    overflow-x:hidden;
}

#game{
    width:100%;
    min-height:100vh;
    display:grid;
    grid-template-columns:120px minmax(0,1fr) 120px;
    grid-template-rows:65px minmax(0,1fr) 155px;
    gap:5px;
    padding:6px;
}

.topbar{
    grid-column:1 / 4;
    grid-row:1;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:4px 10px;
}

.title{
    font-size:clamp(22px,3vw,34px);
    font-weight:1000;
    letter-spacing:2px;
    text-shadow:0 3px 5px #0009;
}

.info{
    display:flex;
    gap:5px;
    flex-wrap:wrap;
    justify-content:flex-end;
}

.info-box{
    background:#0007;
    border:1px solid #ffffff33;
    border-radius:7px;
    padding:5px 9px;
    font-size:12px;
}

.cpu-player{
    display:flex;
    justify-content:center;
    align-items:center;
}

.cpu-player.left{
    grid-column:1;
    grid-row:2;
}

.cpu-player.right{
    grid-column:3;
    grid-row:2;
}

.cpu-top{
    grid-column:2;
    grid-row:2;
    display:flex;
    justify-content:center;
    align-items:flex-start;
}

.cpu-box{
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:5px;
}

.player-name{
    font-size:13px;
    font-weight:900;
    text-align:center;
}

.cpu-hand{
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:70px;
}

.cpu-hand.vertical{
    flex-direction:column;
}

.cpu-hand.vertical .card{
    margin-top:-45px;
}

.cpu-hand.vertical .card:first-child{
    margin-top:0;
}

.center{
    grid-column:2;
    grid-row:2;
    width:100%;
    height:100%;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:45px;
}

.zone{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:7px;
    min-width:70px;
}

.zone-label{
    font-size:13px;
    font-weight:900;
    text-shadow:0 2px 3px #000;
}

.zone-label span{
    color:#ffe45c;
}

.card{
    width:48px;
    height:68px;
    border:2px solid white;
    border-radius:7px;
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;
    flex-shrink:0;
    user-select:none;
    box-shadow:
        0 3px 7px #0009,
        inset 0 0 0 2px #0002;
}

.card.red{
    background:linear-gradient(145deg,#ff4b4b,#c90000);
}

.card.yellow{
    background:linear-gradient(145deg,#ffe45c,#dba800);
    color:#111;
}

.card.green{
    background:linear-gradient(145deg,#37df76,#079344);
}

.card.blue{
    background:linear-gradient(145deg,#43baff,#0872c9);
}

.card.black{
    background:radial-gradient(circle at 35% 30%,#555,#111 70%);
}

.card.back{
    background:
        repeating-linear-gradient(
            45deg,
            #171717 0,
            #171717 5px,
            #292929 5px,
            #292929 10px
        );
}

.card.back::after{
    content:"UNO";
    font-size:12px;
    font-weight:1000;
    transform:rotate(-25deg);
}

.card-content{
    font-size:21px;
    font-weight:1000;
    text-align:center;
    line-height:1.05;
    text-shadow:0 2px 2px #0008;
}

.card-corner{
    position:absolute;
    left:3px;
    top:2px;
    font-size:7px;
    font-weight:900;
}

.card-corner.bottom{
    left:auto;
    right:3px;
    top:auto;
    bottom:2px;
    transform:rotate(180deg);
}

.center .card{
    width:65px;
    height:92px;
}

.center .card-content{
    font-size:25px;
}

.player-area{
    grid-column:1 / 4;
    grid-row:3;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-end;
}

.player-label{
    font-size:13px;
    font-weight:900;
}

.player-hand{
    width:100%;
    min-height:90px;
    display:flex;
    justify-content:center;
    align-items:flex-end;
    gap:3px;
    flex-wrap:wrap;
    padding:4px;
}

.player-card{
    cursor:pointer;
    transition:.15s;
}

.player-card:hover{
    transform:translateY(-12px) scale(1.04);
    z-index:50;
}

.playable{
    box-shadow:
        0 0 9px #fff,
        0 4px 8px #0008;
}

.unplayable{
    filter:brightness(.55) saturate(.6);
}

.exodia-card{
    background:
        linear-gradient(
            145deg,
            #70420b,
            #e4b33f 45%,
            #8b5a16
        ) !important;

    border-color:#ffe99a !important;

    box-shadow:
        0 0 7px #ffcc33,
        0 0 15px #ffbf0088,
        inset 0 0 8px #fff07866;
}

.exodia-card .card-content{
    font-size:8px;
    line-height:1.05;
}

.exodia-symbol{
    font-size:16px;
    margin-bottom:3px;
}

.controls{
    position:fixed;
    left:50%;
    bottom:150px;
    transform:translateX(-50%);
    display:flex;
    gap:6px;
    z-index:100;
}

button{
    border:none;
    border-radius:7px;
    padding:7px 12px;
    font-weight:900;
    cursor:pointer;
    color:white;
    background:#222;
    box-shadow:0 3px 6px #0008;
}

button:hover{
    filter:brightness(1.15);
}

button:disabled{
    opacity:.4;
    cursor:not-allowed;
}

#drawButton{
    background:#7d2cff;
}

#unoButton{
    background:#e51b23;
}

#restartButton{
    background:#0872c9;
}

#backToMenuButton{
    position:fixed;
    top:12px;
    right:12px;
    z-index:6500;
    padding:8px 12px;
    border-radius:8px;
    border:1px solid #9bd8ff;
    background:#123;
    color:white;
    font-size:13px;
    font-weight:900;
    box-shadow:0 3px 6px #0008;
}

#backToMenuButton:hover{
    filter:brightness(1.15);
}

.message{
    position:fixed;
    top:70px;
    left:50%;
    transform:translateX(-50%);
    background:#0009;
    border-radius:8px;
    padding:5px 12px;
    font-size:13px;
    font-weight:900;
    z-index:500;
    white-space:nowrap;
}

.uno-badge{
    position:fixed;
    right:15px;
    top:82px;
    width:45px;
    height:45px;
    background:#e60000;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    font-weight:1000;
    font-size:12px;
    box-shadow:0 0 15px #f00;
    animation:pulse 1s infinite alternate;
    z-index:1000;
}

.hidden{
    display:none !important;
}

@keyframes pulse{
    from{
        transform:scale(1);
    }
    to{
        transform:scale(1.12);
    }
}

#effectLayer{
    position:fixed;
    inset:0;
    pointer-events:none;
    overflow:hidden;
    z-index:3000;
}

.effect-text{
    position:absolute;
    left:50%;
    top:43%;
    transform:translate(-50%,-50%) scale(.3);
    font-size:clamp(40px,9vw,95px);
    font-weight:1000;
    font-style:italic;
    text-shadow:
        0 5px #000,
        0 0 20px currentColor;
    opacity:0;
    animation:effectPop 1.1s ease-out forwards;
}

@keyframes effectPop{
    0%{
        opacity:0;
        transform:
            translate(-50%,-50%)
            scale(.2)
            rotate(-8deg);
    }

    20%{
        opacity:1;
        transform:
            translate(-50%,-50%)
            scale(1.25)
            rotate(5deg);
    }

    70%{
        opacity:1;
        transform:
            translate(-50%,-50%)
            scale(1)
            rotate(-2deg);
    }

    100%{
        opacity:0;
        transform:
            translate(-50%,-60%)
            scale(1.5);
    }
}

.shake{
    animation:shake .45s ease-in-out;
}

@keyframes shake{
    0%,100%{
        transform:translate(0);
    }

    20%{
        transform:translate(-9px);
    }

    40%{
        transform:translate(9px);
    }

    60%{
        transform:translate(-6px);
    }

    80%{
        transform:translate(6px);
    }
}

.overlay{
    position:fixed;
    inset:0;
    background:#000b;
    z-index:5000;
    display:flex;
    justify-content:center;
    align-items:center;
}

.modal{
    width:min(90vw,500px);
    padding:28px;
    text-align:center;
    border-radius:15px;
    background:
        linear-gradient(145deg,#174a2d,#082c19);
    border:2px solid #66ff9c;
    box-shadow:
        0 0 35px #00ff6644,
        0 20px 60px #000;
}

.modal h1{
    margin:0 0 15px;
}

.roulette-name{
    min-height:70px;
    display:flex;
    justify-content:center;
    align-items:center;
    color:#ffdf45;
    font-size:38px;
    font-weight:1000;
}

.start-button{
    margin-top:15px;
    background:#e49b00;
    font-size:16px;
}

.color-buttons{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:9px;
}

.color-button{
    height:52px;
    border:2px solid white;
}

.color-button.red{
    background:#d60000;
}

.color-button.yellow{
    background:#e2ad00;
    color:#111;
}

.color-button.green{
    background:#079344;
}

.color-button.blue{
    background:#0872c9;
}

.win-box{
    width:min(90vw,540px);
    padding:30px;
    text-align:center;
    border-radius:16px;
    background:
        linear-gradient(145deg,#174a2d,#082c19);
    border:2px solid #66ff9c;
}

.win-box.exodia-win{
    border-color:#ffd438;
    box-shadow:
        0 0 40px #ffbd00,
        0 0 100px #ff9d0044;
}

.win-title{
    font-size:45px;
    font-weight:1000;
}

.exodia-win-title{
    color:#ffd43b;
    text-shadow:0 0 25px #ff8c00;
    animation:glow 1s infinite alternate;
}

@keyframes glow{
    from{
        text-shadow:0 0 10px #ff8c00;
    }

    to{
        text-shadow:
            0 0 30px white,
            0 0 50px #ff8c00;
    }
}

.exodia-particle{
    position:fixed;
    left:50%;
    top:50%;
    width:9px;
    height:9px;
    border-radius:50%;
    background:#ffd83d;
    box-shadow:0 0 12px #ffae00;
    pointer-events:none;
    z-index:6000;
    animation:particle 1.5s ease-out forwards;
}

@keyframes particle{
    0%{
        transform:translate(0,0) scale(1);
        opacity:1;
    }

    100%{
        transform:
            translate(
                calc((var(--x) - 50vw)),
                calc((var(--y) - 50vh))
            )
            scale(0);
        opacity:0;
    }
}

@media(max-width:700px){

    #game{
        grid-template-columns:75px minmax(0,1fr) 75px;
        grid-template-rows:55px minmax(0,1fr) 175px;
    }

    .controls{
        bottom:170px;
    }

    .center{
        gap:15px;
    }

    .card{
        width:42px;
        height:60px;
    }

    .center .card{
        width:58px;
        height:82px;
    }
}

.menu-screen{
    position:fixed;
    inset:0;
    z-index:7000;
    background:
        radial-gradient(circle at center,#126b35,#063d1f 55%,#021f10);
    display:flex;
    justify-content:center;
    align-items:center;
    padding:20px;
}

.menu-box{
    width:min(92vw,560px);
    padding:38px;
    border-radius:22px;
    background:#061d11dd;
    border:2px solid #55ff99;
    box-shadow:
        0 0 50px #00ff6644,
        0 25px 70px #000;
    text-align:center;
}

.menu-title{
    font-size:clamp(42px,8vw,70px);
    font-weight:1000;
    letter-spacing:4px;
    color:#ffe04a;
    text-shadow:
        0 4px 0 #8a5900,
        0 0 25px #ffca28;
    margin-bottom:10px;
}

.menu-subtitle{
    font-size:15px;
    margin-bottom:28px;
    opacity:.9;
}

.menu-button{
    display:block;
    width:100%;
    margin:10px 0;
    padding:14px;
    font-size:18px;
    border-radius:11px;
    background:linear-gradient(145deg,#0872c9,#064c89);
}

.menu-button.primary{
    background:linear-gradient(145deg,#e7a900,#a66f00);
    color:#fff;
}

.menu-button.online{
    background:linear-gradient(145deg,#7c38ff,#4d19a7);
}

.menu-button.back{
    background:#222;
}

.settings-box{
    width:min(92vw,600px);
    max-height:90vh;
    overflow:auto;
    padding:30px;
    border-radius:18px;
    background:#071f13f2;
    border:2px solid #66ff9c;
    box-shadow:0 20px 70px #000;
}

.settings-box h2{
    margin-top:0;
    color:#ffe04a;
}

.setting-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    padding:13px 0;
    border-bottom:1px solid #ffffff22;
}

.setting-row select{
    padding:8px;
    border-radius:7px;
    font-weight:900;
}

.rules{
    text-align:left;
    line-height:1.65;
    font-size:13px;
    margin-top:20px;
}

.rules h3{
    color:#ffe04a;
}

.online-panel{
    width:min(92vw,560px);
    padding:30px;
    border-radius:18px;
    background:#071f13f5;
    border:2px solid #a875ff;
    box-shadow:0 20px 70px #000;
    text-align:center;
}

.online-panel h2{
    margin-top:0;
    color:#cda8ff;
}

.online-input{
    width:100%;
    padding:12px;
    margin:6px 0;
    border-radius:8px;
    border:1px solid #ffffff44;
    background:#0008;
    color:white;
    font-size:16px;
    text-align:center;
}

.online-code{
    margin:15px 0;
    padding:15px;
    border-radius:10px;
    background:#0009;
    border:1px solid #a875ff;
    font-size:32px;
    font-weight:1000;
    letter-spacing:8px;
    color:#e1c8ff;
}

.online-status{
    min-height:24px;
    margin:10px 0;
    color:#ffd75a;
    font-weight:900;
}

.online-player-list{
    text-align:left;
    margin:15px auto;
    width:min(100%,400px);
    padding:0;
    list-style:none;
}

.online-player-list li{
    padding:8px 10px;
    margin:4px 0;
    background:#0005;
    border-radius:7px;
}

.online-badge{
    position:fixed;
    left:15px;
    top:82px;
    z-index:1000;
    padding:7px 10px;
    border-radius:8px;
    background:#6e2bd8;
    border:1px solid #c9a4ff;
    font-size:12px;
    font-weight:1000;
}

.turn-indicator{
    position:fixed;
