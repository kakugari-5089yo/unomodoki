/* ================================
   ターン処理
================================ */

function nextPlayer(){

    if(gameOver){
        return;
    }

    const count =
        onlineMode
            ? Math.max(2,onlinePlayerCount)
            : cpuCount + 1;

    let next =
        currentPlayer + direction;

    for(let i=0;i<count;i++){

        if(next < 0){
            next = count - 1;
        }

        if(next >= count){
            next = 0;
        }

        if(
            !players[next].finished
        ){
            currentPlayer = next;
            break;
        }

        next += direction;

    }

    playerSaidUno = false;
    unoPenaltyApplied = false;

    render();

    if(
        onlineMode &&
        onlineIsHost
    ){
        onlineBroadcastState();
    }

    /*
       CPUのターン
    */

    if(
        !onlineMode ||
        onlineIsHost
    ){

        if(
            players[currentPlayer] &&
            players[currentPlayer].type==="cpu" &&
            !players[currentPlayer].finished
        ){

            setTimeout(
                cpuTurn,
                700
            );

        }

    }

}

/* ================================
   CPUターン
================================ */

function cpuTurn(){

    if(gameOver){
        return;
    }

    const player =
        players[currentPlayer];

    if(!player){
        return;
    }

    if(player.finished){

        nextPlayer();

        return;

    }

    /*
       CPUがオンラインの人間枠の場合は
       CPU操作をしない
    */

    if(
        onlineMode &&
        player.type==="human"
    ){

        return;

    }

    /*
       ドロー処理
    */

    if(pendingDraw>0){

        const amount =
            pendingDraw;

        for(
            let i=0;
            i<amount;
            i++
        ){

            const card =
                drawFromDeck();

            if(card){

                player.hand.push(card);

            }

        }

        pendingDraw = 0;
        pendingDrawSource = null;

        render();

        setTimeout(
            nextPlayer,
            500
        );

        return;

    }

    /*
       出せるカードを探す
    */

    const playable = [];

    player.hand.forEach(
        (card,index)=>{

            if(
                canPlayCardForPlayer(
                    card,
                    player
                )
            ){

                playable.push(index);

            }

        }
    );

    /*
       出せるカードがない
    */

    if(playable.length===0){

        const card =
            drawFromDeck();

        if(card){

            player.hand.push(card);

            showMessage(
                `${player.name} がカードを1枚引きました。`
            );

        }

        render();

        setTimeout(
            ()=>{
                /*
                   引いたカードが出せる場合は
                   そのカードを出す
                */

                const last =
                    player.hand[
                        player.hand.length-1
                    ];

                if(
                    last &&
                    canPlayCardForPlayer(
                        last,
                        player
                    )
                ){

                    playerPlay(
                        player.hand.length-1,
                        currentPlayer
                    );

                }else{

                    nextPlayer();

                }

            },
            500
        );

        return;

    }

    /*
       CPUがカードを選択
    */

    const index =
        chooseCpuCard(
            player,
            playable
        );

    playerPlay(
        index,
        currentPlayer
    );

}

/* ================================
   CPUカード判定
================================ */

function canPlayCardForPlayer(
    card,
    player
){

    if(
        !player ||
        player.finished
    ){

        return false;

    }

    if(card.type==="wild"){

        return true;

    }

    if(card.type==="wild4"){

        return true;

    }

    if(pendingDraw>0){

        return false;

    }

    const top =
        discardPile[
            discardPile.length-1
        ];

    if(!top){

        return true;

    }

    if(card.type==="exodia"){

        return true;

    }

    if(top.type==="exodia"){

        return true;

    }

    if(
        card.color===currentColor
    ){

        return true;

    }

    if(
        card.value===top.value
    ){

        return true;

    }

    if(
        card.type===top.type &&
        (
            card.type==="skip" ||
            card.type==="reverse" ||
            card.type==="draw2"
        )
    ){

        return true;

    }

    return false;

}

/* ================================
   CPUカード選択
================================ */

function chooseCpuCard(
    player,
    playable
){

    /*
       Exodiaを優先
    */

    for(const index of playable){

        if(
            player.hand[index].type==="exodia"
        ){

            return index;

        }

    }

    /*
       +4
    */

    for(const index of playable){

        if(
            player.hand[index].type==="wild4"
        ){

            return index;

        }

    }

    /*
       +2
    */

    for(const index of playable){

        if(
            player.hand[index].type==="draw2"
        ){

            return index;

        }

    }

    /*
       通常カード
    */

    return playable[
        Math.floor(
            Math.random()*playable.length
        )
    ];

}

/* ================================
   カードを出す
================================ */

function playerPlay(
    index,
    playerIndex=0
){

    if(gameOver){

        return;

    }

    if(
        currentPlayer!==playerIndex
    ){

        return;

    }

    const player =
        players[playerIndex];

    if(!player){

        return;

    }

    if(player.finished){

        return;

    }

    const card =
        player.hand[index];

    if(!card){

        return;

    }

    if(
        !canPlayCardForPlayer(
            card,
            player
        )
    ){

        if(playerIndex===0){

            showMessage(
                "そのカードは出せません。"
            );

        }

        return;

    }

    /*
       手札から削除
    */

    player.hand.splice(
        index,
        1
    );

    /*
       捨て札へ
    */

    discardPile.push(card);

    /*
       色の更新
    */

    if(
        card.type==="wild" ||
        card.type==="wild4"
    ){

        awaitingColor = true;

    }else{

        currentColor =
            card.color;

    }

    /*
       効果処理
    */

    let skipNext = false;

    if(card.type==="skip"){

        skipNext = true;

        showEffect("SKIP");

    }

    if(card.type==="reverse"){

        direction *= -1;

        showEffect("REVERSE");

        /*
           2人対戦では
           ReverseをSkipとして扱う
        */

        if(
            (
                onlineMode
                    ? onlinePlayerCount
                    : cpuCount + 1
            )===2
        ){

            skipNext = true;

        }

    }

    if(card.type==="draw2"){

        pendingDraw += 2;

        pendingDrawSource =
            player;

        showEffect("+2");

    }

    if(card.type==="wild4"){

        pendingDraw += 4;

        pendingDrawSource =
            player;

        showEffect("+4");

    }

    if(card.type==="wild"){

        /*
           通常WILDは
           ドロー効果を解除する
        */

        pendingDraw = 0;

        pendingDrawSource = null;

        showEffect("WILD");

    }

    if(card.type==="exodia"){

        showEffect(
            getExodiaName(
                card.exodia
            )
        );

    }

    render();

    /*
       Exodia判定
    */

    if(
        checkExodia(
            player
        )
    ){

        return;

    }

    /*
       通常の上がり
    */

    if(
        player.hand.length===0
    ){

        handlePlayerFinish(
            playerIndex
        );

        return;

    }

    /*
       UNO処理
    */

    if(
        player.hand.length===1 &&
        playerIndex===0
    ){

        if(!playerSaidUno){

            showMessage(
                "UNOを押してください！"
            );

        }

    }

    /*
       ワイルドの場合は
       色選択
    */

    if(
        awaitingColor &&
        (
            card.type==="wild" ||
            card.type==="wild4"
        ) &&
        playerIndex===0
    ){

        openColorSelection();

        return;

    }

    /*
       CPUのワイルド
    */

    if(
        awaitingColor &&
        (
            card.type==="wild" ||
            card.type==="wild4"
        ) &&
        player.type==="cpu"
    ){

        const color =
            chooseCpuColor(
                player
            );

        selectColor(
            color,
            playerIndex
        );

        return;

    }

    /*
       Skip
    */

    if(skipNext){

        nextPlayer();

        return;

    }

    /*
       次のプレイヤー
    */

    nextPlayer();

}

/* ================================
   CPU色選択
================================ */

function chooseCpuColor(player){

    const counts = {
        red:0,
        yellow:0,
        green:0,
        blue:0
    };

    player.hand.forEach(
        card=>{

            if(
                counts[card.color]!==undefined
            ){

                counts[card.color]++;

            }

        }
    );

    let best =
        "red";

    for(const color of COLORS){

        if(
            counts[color] >
            counts[best]
        ){

            best = color;

        }

    }

    return best;

}

/* ================================
   色選択画面
================================ */

function openColorSelection(){

    colorOverlay.classList.remove(
        "hidden"
    );

}

/* ================================
   色選択
================================ */

function selectColor(
    color,
    playerIndex=0
){

    if(!awaitingColor){

        return;

    }

    if(
        !COLORS.includes(color)
    ){

        return;

    }

    awaitingColor = false;

    currentColor = color;

    colorOverlay.classList.add(
        "hidden"
    );

    showMessage(
        `色は${COLOR_NAMES[color]}です。`
    );

    /*
       色選択後は通常通り次へ
    */

    nextPlayer();

}

/* ================================
   ドロー
================================ */

function playerDraw(
    playerIndex=0
){

    if(gameOver){

        return;

    }

    if(
        currentPlayer!==playerIndex
    ){

        return;

    }

    const player =
        players[playerIndex];

    if(!player){

        return;

    }

    if(player.finished){

        return;

    }

    let amount = 1;

    if(pendingDraw>0){

        amount =
            pendingDraw;

        pendingDraw = 0;

        pendingDrawSource = null;

    }

    for(
        let i=0;
        i<amount;
        i++
    ){

        const card =
            drawFromDeck();

        if(card){

            player.hand.push(card);

        }

    }

    showMessage(
        `${player.name} が${amount}枚引きました。`
    );

    render();

    /*
       ドロー後は次のプレイヤー
    */

    nextPlayer();

}

/* ================================
   UNO
================================ */

function playerUno(
    playerIndex=0
){

    if(gameOver){

        return;

    }

    if(
        currentPlayer!==playerIndex
    ){

        return;

    }

    const player =
        players[playerIndex];

    if(!player){

        return;

    }

    if(
        player.hand.length!==1
    ){

        showMessage(
            "UNOを宣言できる状態ではありません。"
        );

        return;

    }

    playerSaidUno = true;

    unoPenaltyApplied = false;

    showMessage(
        `${player.name}：UNO！`
    );

}

/* ================================
   Exodia判定
================================ */

function checkExodia(player){

    const found = {};

    player.hand.forEach(
        card=>{

            if(
                card.type==="exodia" &&
                card.exodia
            ){

                found[
                    card.exodia
                ] = true;

            }

        }
    );

    const complete =
        EXODIA_TYPES.every(
            type=>found[type]
        );

    if(!complete){

        return false;

    }

    /*
       Exodia完成
    */

    showEffect(
        "EXODIA COMPLETE!"
    );

    /*
       プレイヤーが完成した場合だけ
       ラウンド終了
    */

    if(
        player.type==="human"
    ){

        handleExodiaWin(
            player
        );

        return true;

    }

    /*
       CPUは終了扱いにするが
       ラウンドは継続
    */

    player.finished = true;

    showMessage(
        `${player.name} がEXODIAを完成させました！`
    );

    render();

    setTimeout(
        nextPlayer,
        800
    );

    return true;

}

/* ================================
   CPU・プレイヤー終了処理
================================ */

function handlePlayerFinish(
    playerIndex
){

    const player =
        players[playerIndex];

    if(!player){

        return;

    }

    /*
       プレイヤーが終了した場合
       ラウンド終了
    */

    if(player.type==="human"){

        player.finished = true;

        gameOver = true;

        showWin(
            player,
            false
        );

        return;

    }

    /*
       CPUは終了しても
       ラウンド継続
    */

    player.finished = true;

    showMessage(
        `${player.name} は上がりました。ゲームは続きます。`
    );

    render();

    setTimeout(
        nextPlayer,
        700
    );

}

/* ================================
   Exodia勝利
================================ */

function handleExodiaWin(player){

    player.finished = true;

    gameOver = true;

    showWin(
        player,
        true
    );

}

